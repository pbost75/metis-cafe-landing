# Copie ce fichier en ".env" à la racine du projet.
# Ne commite jamais le fichier .env (il reste sur ta machine).

# Google Tag Manager (recommandé) — ID du type GTM-XXXXXXX
VITE_GTM_ID=GTM-XXXXXXX

# Google Analytics 4 — uniquement si tu n’utilises PAS GTM pour GA4.
# Avec GTM actif, laisse cette ligne commentée et configure GA4 dans tagmanager.google.com
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
